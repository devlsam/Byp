<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="byp.exe"
        Arguments=""
        InstallLocation="C:\Program Files\BYP\BYP Client">
    </Installer>
    <PackageInformation
        PackageName="BYP Client"
        PackageDisplayName="BYP Client"
        PublisherName="CN=BYP"
        PublisherDisplayName="BYP"
        Version="0.1.0.0"
        PackageDescription="BYP Client application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.byp.client"
                Description="BYP Client application"
                DisplayName="BYP Client"
                ExecutableName="byp.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Star Client</DisplayName>
            <PublisherDisplayName>Star</PublisherDisplayName>
            <Description>Star Client application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="star.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
